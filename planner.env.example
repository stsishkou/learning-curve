# Settings for the planner container. Copy to planner.env (git-ignored: it holds secrets) and uncomment what you use.

# View only: the plan is shown and every editing control is hidden. For a public showcase.
# PLAN_READONLY=1

# OAuth clients of the calendar apps; they win over a client saved in the app.
# Register https://<your-domain>/api/google/callback and https://<your-domain>/api/outlook/callback on them.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# OUTLOOK_CLIENT_ID=
# OUTLOOK_CLIENT_SECRET=

# Your own calendar's secret .ics address, for busy time; the app then cannot change it.
# BUSY_ICS_URL=

# The guide's federation remote, for the planner's docs button (no button when unset).
# DOCS_REMOTE_URL=https://<owner>.github.io/<repo>/remote/v1/mf-manifest.json
# The guide's own address, when it is not two levels above the remote.
# DOCS_SITE_URL=

# The `proxy` service (compose.yaml, Caddyfile): the domain whose DNS points at this server, and the one account
# that may open the planner. Make the hash with:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'your password'
# and keep it in single quotes, so its `$` signs are taken as they are.
# PLANNER_DOMAIN=planner.example.com
# PROXY_USER=me
# PROXY_PASSWORD_HASH='$2a$14$...'
