{
  "name": "@lc/remote-host",
  "private": true,
  "description": "What a React host needs to show a Module Federation remote: loadRemote fetches one module with the federation runtime, shares the host's React and reports failure for a fallback; ./docs is the docs remote's hook",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./docs": "./src/docs/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint -c ../../.oxlintrc.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@lc/docs-contract": "workspace:*",
    "@module-federation/runtime": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "nx": {
    "tags": [
      "type:shared",
      "scope:shared"
    ]
  }
}
