{
  "name": "@lc/plan-data",
  "private": true,
  "description": "The plan database on disk (data/plan.json, data/edits.json) and the command that regenerates it. Node only",
  "type": "module",
  "exports": {
    "./fs": "./src/fs/index.ts",
    "./ical": "./src/ical/index.ts",
    "./highs": "./src/highs/index.ts",
    "./google": "./src/google/index.ts",
    "./outlook": "./src/outlook/index.ts",
    "./local": "./src/local/index.ts"
  },
  "scripts": {
    "plan": "tsx scripts/build-plan.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint -c ../../.oxlintrc.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@lc/plan-content": "workspace:*",
    "@lc/plan-domain": "workspace:*",
    "@lc/plan-service": "workspace:*",
    "highs": "catalog:",
    "ical.js": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "vitest": "catalog:"
  },
  "nx": {
    "tags": [
      "type:infra",
      "scope:plan"
    ]
  }
}
