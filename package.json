{
  "name": "learning-curve",
  "private": true,
  "description": "Personal study plan: schedule database, viewer and .ics export",
  "type": "module",
  "scripts": {
    "dev": "nx run @lc/web:dev",
    "build": "nx run-many -t build --output-style=stream",
    "start": "nx run @lc/web:start",
    "stand": "nx run @lc/stand:dev",
    "stand:build": "nx run @lc/stand:build --output-style=stream",
    "stand:test": "nx run @lc/stand:test --output-style=stream",
    "test": "nx run-many -t test -p @lc/plan-domain @lc/plan-data @lc/planner @lc/dashboard @lc/i18n @lc/docs-contract @lc/remote-host @lc/docs @lc/plan-content @lc/plan-service @lc/mcp --output-style=stream",
    "docs": "nx run @lc/docs:dev",
    "docs:build": "nx run @lc/docs:build --output-style=stream",
    "docs:test": "nx run @lc/docs-harness:test --output-style=stream",
    "plan": "nx run @lc/plan-data:plan --output-style=stream",
    "mcp": "pnpm --silent --filter @lc/mcp run start",
    "i18n": "nx run-many -t i18n",
    "typecheck": "nx run-many -t typecheck",
    "lint": "nx run-many -t lint lint:fsd",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check:i18n": "nx run-many -t check:i18n",
    "check": "node scripts/check-graph.ts && nx run-many -t typecheck lint lint:fsd check:i18n --output-style=stream && oxfmt --check",
    "affected": "nx affected -t typecheck lint lint:fsd check:i18n build --output-style=stream",
    "graph": "nx graph",
    "prepare": "husky && nx run-many -t i18n"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@feature-sliced/steiger-plugin": "0.8.2",
    "@inlang/paraglide-js": "catalog:",
    "husky": "9.1.7",
    "nx": "24.0.6",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2008",
    "steiger": "0.10.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.21.0"
}
