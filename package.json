{
  "name": "learning-curve",
  "private": true,
  "description": "Personal study plan: schedule database, viewer and .ics export",
  "type": "module",
  "scripts": {
    "dev": "nx run @lc/web:dev",
    "build": "nx run-many -t build",
    "start": "nx run @lc/web:start",
    "plan": "nx run @lc/web:plan",
    "i18n": "nx run-many -t i18n",
    "typecheck": "nx run-many -t typecheck",
    "lint": "nx run-many -t lint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check:i18n": "nx run-many -t check:i18n",
    "check": "nx run-many -t typecheck lint check:i18n && oxfmt --check",
    "affected": "nx affected -t typecheck lint check:i18n build",
    "graph": "nx graph",
    "prepare": "husky && nx run-many -t i18n"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@inlang/paraglide-js": "3.2.2",
    "husky": "9.1.7",
    "nx": "24.0.6",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2008",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.21.0"
}
