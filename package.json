{
  "name": "learning-curve",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node .output/server/index.mjs",
    "plan": "tsx scripts/build-plan.ts",
    "i18n": "paraglide-js compile --project ./project.inlang",
    "typecheck": "pnpm run i18n && tsc --noEmit",
    "check:i18n": "inlang check --project ./project.inlang --source ./src/routes ./src/components ./src/lib/format.ts",
    "prepare": "husky && pnpm run i18n"
  },
  "dependencies": {
    "@inlang/paraglide-js": "3.2.2",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.7",
    "jszip": "3.10.2",
    "nitro": "3.0.261103-rc",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@inlang/cli": "3.6.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "husky": "9.1.7",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "description": "Personal study plan: schedule database, viewer and .ics export",
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.21.0"
}
