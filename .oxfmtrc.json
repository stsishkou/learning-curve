{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "semi": false,
  "singleQuote": true,
  "sortImports": true,
  "sortTailwindcss": { "stylesheet": "./apps/web/src/styles.css" },
  "ignorePatterns": [
    "**/data/plan.json",
    "**/plan-domain/src/content.ts",
    "**/routeTree.gen.ts",
    "**/messages/",
    "pnpm-lock.yaml",
    "*.md",
    ".idea/",
    ".claude/",
    ".nx/"
  ]
}
